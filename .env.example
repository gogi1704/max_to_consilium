# Токен чат-бота из платформы MAX для партнёров.
MAX_BOT_TOKEN=

# Локальный адрес ai_project:
CONSILIUM_API_URL=http://127.0.0.1:8000

# Должен полностью совпадать с BOT_INTEGRATION_SECRET в .env ai_project.
BOT_INTEGRATION_SECRET=

REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
HEALTHCHECK_FILE=/tmp/consilium-max-bot.heartbeat
HEALTHCHECK_MAX_AGE=120
