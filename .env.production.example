# Токен чат-бота MAX. Рабочее значение храните только в .env на сервере.
MAX_BOT_TOKEN=replace-with-max-bot-token

# Имя сервиса и внутренний порт Консилиума в сети consilium-internal.
CONSILIUM_API_URL=http://consilium:8000

# Должен посимвольно совпадать с BOT_INTEGRATION_SECRET Консилиума.
BOT_INTEGRATION_SECRET=replace-with-the-same-long-random-secret

REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
HEALTHCHECK_FILE=/tmp/consilium-max-bot.heartbeat
HEALTHCHECK_MAX_AGE=120
